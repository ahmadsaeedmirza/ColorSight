<!--
  Merge into AndroidManifest <application> for ColorSight share (ACTION_SEND).
  Authority must match photo_io._share_android: <package>.fileprovider
  With package.domain=org.colorsight and package.name=colorsight →
  org.colorsight.colorsight.fileprovider
-->
<provider
    android:name="androidx.core.content.FileProvider"
    android:authorities="${applicationId}.fileprovider"
    android:exported="false"
    android:grantUriPermissions="true">
    <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
</provider>
