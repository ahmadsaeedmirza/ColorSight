# Force LF for packaging / CI-sensitive text (CRLF has broken Buildozer + hooks before)
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.spec text eol=lf
constraints.txt text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.kv text eol=lf
*.txt text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.otf binary
*.apk binary
